# انسخ هذا الملف باسم .env ولا ترفعه أبداً إلى Git أو أي مكان عام
NODE_ENV=production
PORT=4000

# اتصال قاعدة البيانات (استخدم حساب awqaf_app المحدود الصلاحيات من schema.sql وليس superuser)
DATABASE_URL=postgresql://awqaf_app:CHANGE_ME_STRONG_RANDOM_SECRET@localhost:5432/awqaf_sweida
DATABASE_SSL=false

# أسرار JWT — ولّد كل واحد بأمر منفصل، لا تستخدم القيم أدناه كما هي:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME_64_BYTE_RANDOM_HEX
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_64_BYTE_RANDOM_HEX
JWT_ACCESS_EXPIRES_MIN=15
JWT_REFRESH_EXPIRES_DAYS=7

# النطاق المسموح له بالاتصال بالـ API (الواجهة الأمامية فقط)
CORS_ORIGIN=https://your-frontend-domain.example

# سياسة القفل بعد محاولات دخول فاشلة
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# ملاحظة: يجب أن يعمل هذا الخادم خلف وسيط عكسي (nginx/Caddy) يوفر HTTPS.
# لا تعرّض هذا الخادم مباشرة على الإنترنت بدون TLS.
TRUST_PROXY=1
